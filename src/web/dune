(env
 (_
  (js_of_ocaml
   (compilation_mode whole_program))
  (wasm_of_ocaml
   (compilation_mode whole_program))))

(executables
 (names viewer)
 (libraries mountains yojson brr lwt)
 (preprocess
  (pps ppx_blob))
 (preprocessor_deps
  (glob_files shaders/*))
 (modes js wasm)
 (js_of_ocaml
  (javascript_files inflate.js))
 (wasm_of_ocaml
  (javascript_files inflate.js)
  (wasm_files inflate.wat)))

(executables
 (names worker)
 (libraries mountains brr)
 (modes js)
 (js_of_ocaml
  (javascript_files inflate.js)))

; Only what the client actually fetches: the raw Copernicus .tif sources
; (~940 MB) are pipeline inputs for compress_dem and would push the Pages
; artifact over its 1 GB limit.

(rule
 (target
  (dir data))
 (alias all)
 (deps
  (glob_files_rec ../../data/dem/**)
  (glob_files_rec ../../data/clc/**)
  ../../data/points.geojson)
 (action
  (progn
   (run mkdir -p %{target})
   (run cp -r ../../data/dem %{target}/dem)
   (run cp -r ../../data/clc %{target}/clc)
   (run cp ../../data/points.geojson %{target}/points.geojson))))

(rule
 (target
  (dir assets))
 (alias all)
 (deps
  (glob_files_rec ../../assets/**))
 (action
  (progn
   (run mkdir %{target})
   (run cp %{deps} %{target}))))

(rule
 (target service_worker.bc.js)
 (alias all)
 (deps service_worker/service_worker.bc.js)
 (action
  (copy %{deps} %{target})))

(alias
 (name all)
 (deps index.html manifest.json icon192.png icon512.png))

(rule
 (alias web)
 (action
  (run python3 -m http.server -d .))
 (deps
  index.html
  data
  viewer.bc.js
  viewer.bc.wasm.js
  service_worker.bc.js
  manifest.json
  icon192.png
  icon512.png
  decode_clc.wasm
  decompress_tile.wasm
  worker.bc.js))

(rule
 (target decompress_tile.wasm)
 (deps decompress_tile.wat)
 (action
  (run wasm-opt -O4 --enable-simd --enable-bulk-memory %{deps} -o %{target})))

(rule
 (target decode_clc.wasm)
 (deps decode_clc.wat)
 (action
  (run wasm-opt -O4 --enable-simd --enable-bulk-memory %{deps} -o %{target})))
