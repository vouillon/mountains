(library
 (name static_r_tree)
 (modules static_r_tree hilbert)
 (preprocess
  (pps ppx_inline_test))
 (inline_tests))

; Non-graphics core: everything the test executables need, kept free of
; SDL/GLES/SQLite so the CI test job only installs light dependencies.
; earcut and debug_triangles are referenced by nothing and are not built.

(library
 (name corine_core)
 (wrapped false)
 (modules
  geometry_types
  polygon_validation
  polygon_clipping
  polygon_triangulation
  polygon_test_utils
  earcut
  wkb_decode
  osm_fetch
  poi_fetch
  proj_3035
  proj_2975)
 (libraries static_r_tree yojson unix))

(executables
 (names
  corine
  draw_clc
  render_clc
  check_overlaps
  extract_tiles
  compress_dem
  render_dem
  triangulate_test
  polygon_to_svg
  analyze_polygon)
 (modules
  corine
  draw_clc
  render_clc
  check_overlaps
  extract_tiles
  compress_dem
  render_dem
  triangulate_test
  polygon_to_svg
  analyze_polygon)
 (libraries
  corine_core
  static_r_tree
  sqlite3
  str
  tsdl
  tgls.tgles3
  zip
  yojson
  unix
  mountains)
 (ocamlopt_flags
  (-cclib -lGLESv2)))

(executables
 (names triangulation_tests data_tests run_earcut_tests run_earcut_bench)
 (modules triangulation_tests data_tests run_earcut_tests run_earcut_bench)
 (libraries corine_core static_r_tree))

(rule
 (alias runtest)
 (deps
  (glob_files test_polygons/*))
 (action
  (with-stdout-to
   triangulation_tests.output
   (with-accepted-exit-codes
    (or 0 1)
    (run ./triangulation_tests.exe)))))

(rule
 (alias runtest)
 (action
  (diff triangulation_tests.expected triangulation_tests.output)))

(rule
 (alias runtest)
 (action
  (with-stdout-to
   data_tests.output
   (run ./data_tests.exe))))
