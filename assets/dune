(rule
 (alias textures)
 (target details.png)
 (deps rock.png grass.png forest.png ice.png)
 (action
  (run magick convert %{deps} -resize 1024x1024 -combine %{target})))

(rule
 (alias textures)
 (target details.ktx2)
 (deps details.png)
 (action
  (run
   toktx
   --assign_oetf
   linear
   --encode
   uastc
   --genmipmap
   %{target}
   %{deps})))

(rule
 (alias textures)
 (mode promote)
 (target details_bc7.ktx2)
 (deps details.ktx2)
 (action
  (run ktx transcode --target bc7 %{deps} %{target})))

(rule
 (alias textures)
 (mode promote)
 (target details_astc.ktx2)
 (deps details.ktx2)
 (action
  (run ktx transcode --target astc %{deps} %{target})))

(rule
 (alias textures)
 (mode promote)
 (target details_etc2.ktx2)
 (deps details.ktx2)
 (action
  (run ktx transcode --target etc-rgba %{deps} %{target})))
